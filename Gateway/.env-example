IMAGE_ANALYZER_BASE_URL=http://image_analyzer:80
MASK_GENERATOR_BASE_URL=http://mask_generator:80
IMAGE_EDITOR_BASE_URL=http://image_editor:80
UCB_BASE_URL=http://ucb:80
DATA_DISTRIBUTION_TESTER_URL=http://data_distribution_tester:80

RESOURCES_PATH=/resources
GENERATION_PATH=/results
PUBLIC_IP=*

# Distribution test (paper §3.1). The paper reports nu = 0.3 with linear and rbf kernels.
DDT_ENABLED=true
DDT_NU=0.3
DDT_KERNEL=rbf

# Stop generating for a dataset once its cost ledger (results/<dataset_id>/cost_ledger.jsonl) reaches this many
# dollars. Unset = no cap.
# MAX_SPEND_USD=20
