OPENAI_API_KEY=
OPENAI_ORGANIZATION_NAME=
# The paper used DALL-E 2 (shut down 2026-05-12); gpt-image-1 was shut down 2026-10-23.
# gpt-image-2.5-sunburst: most precise edits. gpt-image-2.5-flare: faster, same token price.
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# GPT Image models don't accept 256/512 squares; the smallest square is 1024x1024.
OPENAI_IMAGE_SIZE=1024x1024
# low | medium | high | xhigh | max | auto  (drives cost per image)
OPENAI_IMAGE_QUALITY=low
# high | low ; "high" preserves more of the guide image (more input tokens). Empty for models without support.
OPENAI_INPUT_FIDELITY=high
