OPENAI_API_KEY=
OPENAI_ORGANIZATION_NAME=
# The paper used DALL-E 2, which OpenAI shut down on 2026-05-12. Any GPT Image model with /images/edits works.
OPENAI_IMAGE_MODEL=gpt-image-1
# GPT Image models don't accept 256/512 squares; the smallest square is 1024x1024.
OPENAI_IMAGE_SIZE=1024x1024
# low | medium | high | auto  (drives cost per image)
OPENAI_IMAGE_QUALITY=low
