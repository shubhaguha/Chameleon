# Absolute path on the HOST holding all Chameleon data:
#   resources/<dataset>/   original images (e.g. resources/utkface/2_1_0_20170109205208368.png)
#   datasets/<id>.csv      dataset tables (filename, attr columns..., is_generated)
#   results/<id>/          generated images, masks, base_images, mups
# It must be absolute: ImageAnalyzer passes it to `docker run -v` for the MUP container.
CHAMELEON_DATA_DIR=/absolute/path/to/Chameleon/data
